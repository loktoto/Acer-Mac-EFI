+bool TGLDmic::prepareSwift5Dsp() {
+    uint32_t enabled = 0;
+    if (pciId != WHISKEY_LAKE_AUDIO_PCI_ID ||
+        pci->configRead32(kIOPCIConfigSubSystemVendorID) != SWIFT5_AUDIO_SUBSYSTEM_ID ||
+        platformFamily != kPlatformCometLake ||
+        !PE_parse_boot_argn("tgldmicacerfix", &enabled, sizeof(enabled)) || enabled != 1) {
+        return true;
+    }
+
+    const uint32_t ppctlOffset = ppOffset + HDA::PP_PPCTL;
+    const uint32_t ppctl = r32(ppctlOffset);
+    if (ppctl == 0xFFFFFFFF) {
+        fail("Acer DSP processing control unreadable", ppctl);
+        return false;
+    }
+    if (ppctl & PPCTL_GLOBAL_PROCESSING_ENABLE) return true;
+
+    uint32_t control = d32(DSP::ADSPCS);
+    if (control == 0xFFFFFFFF || (control & CPA(0xFF))) {
+        fail("Acer DSP unavailable or already powered", control);
+        return false;
+    }
+
+    // The Swift 5 can leave the processing block disabled with stale DSP power requests.
+    w32(ppctlOffset, ppctl | PPCTL_GLOBAL_PROCESSING_ENABLE);
+    ownsGlobalProcessingEnable = true;
+    if (!pollHda(ppctlOffset, PPCTL_GLOBAL_PROCESSING_ENABLE,
+                 PPCTL_GLOBAL_PROCESSING_ENABLE, 1000, &control)) {
+        fail("Acer DSP processing enable", control);
+        return false;
+    }
+    control = d32(DSP::ADSPCS);
+    if (control == 0xFFFFFFFF || (control & CPA(0xFF))) {
+        fail("Acer DSP unavailable after processing enable", control);
+        return false;
+    }
+
+    const uint32_t mask = targetCoreMask();
+    dw32(DSP::ADSPCS, control | CSTALL(mask));
+    dw32(DSP::ADSPCS, d32(DSP::ADSPCS) | CRST(mask));
+    if (!pollDsp(DSP::ADSPCS, CRST(mask), CRST(mask), 50000, &control)) {
+        fail("Acer DSP reset", control);
+        return false;
+    }
+    dw32(DSP::ADSPCS, control & ~SPA(mask));
+    if (!pollDsp(DSP::ADSPCS, SPA(mask) | CPA(mask), 0, 50000, &control)) {
+        fail("Acer DSP clear stale power requests", control);
+        return false;
+    }
+    LOG("boot: Acer DSP processing enabled and cores reset, ADSPCS 0x%08x", control);
+    return true;
+}
