+int ItlIwm::
+iwm_awdl_mcc_time_event_cmd(struct iwm_softc *sc, bool add,
+                            uint32_t applyTime, uint32_t intervalTu,
+                            uint32_t durationTu, bool startImmediately)
+{
+    struct iwm_time_event_cmd cmd;
+    memset(&cmd, 0, sizeof(cmd));
+    {
+        uint64_t teAbs = 0, teNs = 0;
+        clock_get_uptime(&teAbs);
+        absolutetime_to_nanoseconds(teAbs, &teNs);
+        sc->sc_awdl_te_cmd_ns = teNs;
+    }
+    cmd.id_and_color = htole32(
+        IWM_AWDL_MACID(sc));
+    cmd.action = htole32(add ? IWM_FW_CTXT_ACTION_ADD :
+                         IWM_FW_CTXT_ACTION_REMOVE);
+    cmd.id = htole32(add ? IWM_TE_P2P_DEVICE_DISCOVERABLE :
+                     sc->sc_awdl_te_uid);
+    if (add) {
+        cmd.apply_time = htole32(applyTime);
+        cmd.max_delay = htole32(0);
+        cmd.interval = htole32(intervalTu);
+        cmd.duration = htole32(durationTu);
+        cmd.repeat = IWM_TE_V2_REPEAT_ENDLESS;
+        cmd.max_frags = IWM_TE_V2_FRAG_NONE;
+        cmd.policy = htole16(IWM_TE_V2_NOTIF_HOST_EVENT_START |
+                             IWM_TE_V2_NOTIF_HOST_EVENT_END |
+                             (startImmediately ?
+                              IWM_T2_V2_START_IMMEDIATELY : 0));
+        // The START notification can race ahead of CMD_WANT_RESP wakeup. Let
+        // the RX handler identify that early notification by AWDL MAC context.
+        sc->sc_awdl_te_pending = 1;
+    }
+    const int err = iwm_send_time_event_cmd(sc, &cmd);
+    sc->sc_awdl_te_pending = 0;
+    if (err == 0) {
+        if (add) {
+            sc->sc_awdl_te_uid = sc->sc_time_event_uid;
+            IOLog("itlwm: AWDL_TE_V2 scheduled uid=%u apply=%u interval=%u "
+                  "duration=%u immediate=%u\n", sc->sc_awdl_te_uid,
+                  applyTime, intervalTu, durationTu,
+                  startImmediately ? 1U : 0U);
+        } else {
+            sc->sc_awdl_te_active = 0;
+            sc->sc_awdl_te_uid = 0;
+        }
+    }
+    return err;
+}
+
+int ItlIwm::
+iwm_ensure_awdl_time_event(void)
+{
+    struct iwm_softc *sc = &com;
+    if (sc->sc_awdl_mcc_state != IWM_AWDL_MCC_ACTIVE)
+        return EINVAL;
+
+    sc->sc_awdl_te_enabled = 1;
+    if (sc->sc_awdl_te_uid != 0)
+        return 0;
+    return iwm_awdl_mcc_time_event_cmd(sc, true, 0, 16, 16, true);
+}
+
+int ItlIwm::
+iwm_align_awdl_time_event(uint32_t applyTime, uint32_t intervalTu,
+                          uint32_t durationTu)
+{
+    struct iwm_softc *sc = &com;
+    if (!sc->sc_awdl_te_enabled ||
+        sc->sc_awdl_mcc_state != IWM_AWDL_MCC_ACTIVE ||
+        intervalTu == 0 || durationTu == 0 ||
+        durationTu > intervalTu)
+        return EINVAL;
+
+    if (sc->sc_awdl_te_uid != 0) {
+        const int removeErr = iwm_awdl_mcc_time_event_cmd(
+            sc, false, 0, 0, 0, false);
+        if (removeErr)
+            return removeErr;
+    }
+    const int alignedErr = iwm_awdl_mcc_time_event_cmd(
+        sc, true, applyTime, intervalTu, durationTu, false);
+    if (alignedErr) {
+        // Preserve the already-proven queue-2 service path if the experimental
+        // phase-aligned command is rejected. Report the original error while
+        // making a best-effort return to the immediate proof event.
+        iwm_awdl_mcc_time_event_cmd(sc, true, 0, 16, 16, true);
+        return alignedErr;
+    }
+    return 0;
+}
+
+// Retune the separate AWDL PHY context to another 5 GHz channel with a
+// single PHY_CONTEXT MODIFY (same band, so never a remove/add). Used to
+// follow the AWDL master's channel schedule; not applicable when the AWDL
+// MAC shares the station's PHY.
+int ItlIwm::
+iwm_awdl_retune(uint16_t channel)
+{
+    struct iwm_softc *sc = &com;
+    struct ieee80211com *ic = &sc->sc_ic;
+    if (sc->sc_awdl_mcc_state != IWM_AWDL_MCC_ACTIVE || sc->sc_awdl_mcc_shared)
+        return EINVAL;
+    if (channel == 0 || channel >= nitems(ic->ic_channels))
+        return EINVAL;
+    struct ieee80211_channel *chan = &ic->ic_channels[channel];
+    if (chan->ic_freq == 0 || !IEEE80211_IS_CHAN_5GHZ(chan))
+        return EINVAL;
+    if (IWM_AWDL_BEACONING(sc) &&
+        (sc->sc_awdl_reg_count == 0 ||
+         (iwm_awdl_reg_flags(channel) &
+          (IWM_NVM_CHANNEL_VALID | IWM_NVM_CHANNEL_ACTIVE | IWM_NVM_CHANNEL_RADAR)) !=
+         (IWM_NVM_CHANNEL_VALID | IWM_NVM_CHANNEL_ACTIVE)))
+        return EPERM;
+    struct iwm_phy_ctxt *phyctxt = &sc->sc_phyctxt[IWM_AWDL_PHY_INDEX];
+    if (phyctxt->channel == chan)
+        return 0;
+    int s = splnet();
+    const int err = iwm_phy_ctxt_update(sc, phyctxt, chan, 1, 1, 0);
+    if (err == 0) {
+        sc->sc_awdl_mcc_channel = channel;
+        ++sc->sc_awdl_retunes;
+    } else {
+        ++sc->sc_awdl_retune_errors;
+    }
+    splx(s);
+    return err;
+}
+
+void ItlIwm::
+iwm_awdl_retune_stats(uint32_t *out2) const
+{
+    out2[0] = com.sc_awdl_retunes;
+    out2[1] = com.sc_awdl_retune_errors;
+}
+
+bool ItlIwm::
+iwm_awdl_channel_usable(uint16_t channel) const
+{
+    const struct ieee80211com *ic = &com.sc_ic;
+    return channel != 0 && channel < nitems(ic->ic_channels) &&
+        ic->ic_channels[channel].ic_freq != 0 &&
+        IEEE80211_IS_CHAN_5GHZ(&ic->ic_channels[channel]);
+}
+
+uint32_t ItlIwm::
+iwm_awdl_reg_flags(uint16_t channel) const
+{
+    return channel < nitems(com.sc_awdl_reg_flags) ?
+        com.sc_awdl_reg_flags[channel] : 0;
+}
+
+int ItlIwm::
+iwm_awdl_mcc_configure(const uint8_t *address, uint16_t channel,
+                       uint32_t *failure_stage)
+{
+    struct iwm_softc *sc = &com;
+    struct ieee80211com *ic = &sc->sc_ic;
+    struct ieee80211_channel *chan;
+    uint32_t completed_stage = 0;
+    int err = 0;
+    int s;
+
+    if (failure_stage != NULL)
+        *failure_stage = 0;
+    if (address == NULL || IEEE80211_ADDR_EQ(address, etheranyaddr) ||
+        channel >= nitems(ic->ic_channels))
+        return EINVAL;
+    chan = &ic->ic_channels[channel];
+    if (chan->ic_freq == 0 || !IEEE80211_IS_CHAN_5GHZ(chan))
+        return EINVAL;
+    if (!isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_DQA_SUPPORT))
+        return ENOTSUP;
+    if (ic->ic_state != IEEE80211_S_RUN ||
+        (sc->sc_flags & (IWM_FLAG_MAC_ACTIVE | IWM_FLAG_BINDING_ACTIVE |
+                         IWM_FLAG_STA_ACTIVE)) !=
+        (IWM_FLAG_MAC_ACTIVE | IWM_FLAG_BINDING_ACTIVE | IWM_FLAG_STA_ACTIVE))
+        return EAGAIN;
+    if (sc->sc_awdl_mcc_state == IWM_AWDL_MCC_ACTIVE &&
+        sc->sc_awdl_mcc_channel == channel &&
+        IEEE80211_ADDR_EQ(sc->sc_awdl_mcc_macaddr, address)) {
+        if (failure_stage != NULL)
+            *failure_stage = sc->sc_awdl_mcc_state;
+        return 0;
+    }
+    if (sc->sc_awdl_mcc_state != 0)
+        iwm_awdl_mcc_teardown();
+
+    if (IWM_AWDL_BEACONING(sc)) {
+        // LMAC 0x23d90 asserts 0x14fc when a GO channel lacks VALID/ACTIVE
+        // or requires radar detection. Query firmware's current profile;
+        // the static NVM channel map can disagree after a country update.
+        sc->sc_awdl_reg_count = 0;
+        // On old firmware this command updates the country rather than
+        // querying it. Never reset the regulatory domain for an AWDL test.
+        if (!isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_WIFI_MCC_UPDATE) &&
+            !isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_LAR_MULTI_MCC))
+            return ENOTSUP;
+        err = iwm_send_update_mcc_cmd(sc, sc->sc_fw_mcc);
+        if (err)
+            return err;
+        const uint32_t flags = iwm_awdl_reg_flags(channel);
+        const uint32_t required = IWM_NVM_CHANNEL_VALID | IWM_NVM_CHANNEL_ACTIVE;
+        IOLog("itlwm: AWDL_GO_REG_V1 channel=%u flags=0x%x count=%u\n",
+              channel, flags, sc->sc_awdl_reg_count);
+        if (sc->sc_awdl_reg_count == 0 || (flags & required) != required ||
+            (flags & IWM_NVM_CHANNEL_RADAR) != 0)
+            return EPERM;
+    }
+
+    s = splnet();
+    sc->sc_awdl_mcc_channel = channel;
+    IEEE80211_ADDR_COPY(sc->sc_awdl_mcc_macaddr, address);
+    {
+        struct iwm_node *bss = (struct iwm_node *)ic->ic_bss;
+        sc->sc_awdl_mcc_shared = sc->sc_awdl_shared_phy && bss != NULL &&
+            bss->in_phyctxt != NULL && bss->in_phyctxt->channel != NULL &&
+            ieee80211_chan2ieee(ic, bss->in_phyctxt->channel) == channel;
+    }
+    if (!sc->sc_awdl_mcc_shared) {
+        err = iwm_phy_ctxt_update(sc, &sc->sc_phyctxt[IWM_AWDL_PHY_INDEX],
+                                  chan, 1, 1, 0);
+        if (err)
+            goto out;
+    }
+
+    if (IWM_AWDL_BEACONING(sc)) {
+        // iwlwifi start_ap_ibss(): pre-22000 firmware takes the beacon
+        // template before the GO MAC is added; set the TBTT from GP2.
+        if (iwm_nic_lock(sc)) {
+            sc->sc_awdl_go_beacon_time =
+                iwm_read_prph(sc, IWM_DEVICE_SYSTEM_TIME_REG);
+            sc->sc_awdl_go_gp2_time = sc->sc_awdl_go_beacon_time;
+            iwm_nic_unlock(sc);
+        }
+        sc->sc_awdl_go_sta_rstamp = ic->ic_bss != NULL ?
+            (uint32_t)ic->ic_bss->ni_rstamp : 0;
+        // ni_rstamp is the AP TSF, not the firmware GP2 clock used here.
+        // Give GO setup half a beacon interval before the first TBTT.
+        if (sc->sc_awdl_go_btime_sta)
+            sc->sc_awdl_go_beacon_time = sc->sc_awdl_go_gp2_time +
+                100U * 1024U / 2U;
+        IOLog("itlwm: AWDL_GO_TIME_V1 gp2=%u sta=%u programmed=%u\n",
+              sc->sc_awdl_go_gp2_time, sc->sc_awdl_go_sta_rstamp,
+              sc->sc_awdl_go_beacon_time);
+        err = iwm_awdl_go_beacon_cmd(sc, address);
+        if (err)
+            goto out;
+    }
+    err = iwm_awdl_mcc_mac_cmd(sc, address, IWM_FW_CTXT_ACTION_ADD);
+    if (err)
+        goto out;
+    sc->sc_awdl_mcc_state |= IWM_AWDL_MCC_MAC_ACTIVE;
+    completed_stage |= IWM_AWDL_MCC_MAC_ACTIVE;
+
+    // iwl_mvm_binding_add_vif disables Smart FIFO before binding a second
+    // data MAC. SF_FULL_ON only supports the single infrastructure station;
+    // GO/IBSS must use SF_UNINIT while both interfaces are bound.
+    if (IWM_AWDL_BEACONING(sc)) {
+        err = iwm_sf_config(sc, IWM_SF_UNINIT);
+        if (err)
+            goto out;
+        sc->sc_awdl_sf_forced = true;
+        IOLog("itlwm: AWDL_GO_SF_V1 disabled before binding\n");
+    }
+
+    err = sc->sc_awdl_mcc_shared ?
+        iwm_awdl_mcc_shared_binding_cmd(sc, true) :
+        iwm_awdl_mcc_binding_cmd(sc, IWM_FW_CTXT_ACTION_ADD);
+    if (err)
+        goto out;
+    sc->sc_awdl_mcc_state |= IWM_AWDL_MCC_BINDING_ACTIVE;
+    completed_stage |= IWM_AWDL_MCC_BINDING_ACTIVE;
+    if (IWM_AWDL_BEACONING(sc) && sc->sc_awdl_go_premod) {
+        err = iwm_awdl_mcc_mac_cmd(sc, address, IWM_FW_CTXT_ACTION_MODIFY);
+        if (err)
+            goto out;
+    }
+    if (IWM_AWDL_BEACONING(sc) && sc->sc_awdl_go_prequota &&
+        !isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_DYNAMIC_QUOTA)) {
+        err = iwm_update_quotas(sc, (struct iwm_node *)ic->ic_bss, 1);
+        if (err)
+            goto out;
+    }
+
+    if (!iwm_nic_lock(sc)) {
+        err = EBUSY;
+        goto out;
+    }
+    err = iwm_enable_txq(sc, IWM_AWDL_BSTA(sc), IWM_AWDL_TXQ(sc),
+                         IWM_TX_FIFO_VO, 0, IWM_MAX_TID_COUNT, 0);
+    iwm_nic_unlock(sc);
+    if (err)
+        goto out;
+    sc->sc_awdl_mcc_state |= IWM_AWDL_MCC_QUEUE_ACTIVE;
+    completed_stage |= IWM_AWDL_MCC_QUEUE_ACTIVE;
+
+    // Firmware 46's ADD_STA path explicitly requires the type-2 multicast
+    // station before the type-1 general-purpose station (assert 0x3438).
+    // This matches iwlmvm when the STA_TYPE API is present.
+    if (IWM_AWDL_BEACONING(sc)) {
+        err = iwm_awdl_go_mcast_sta(sc, true);
+        if (err)
+            goto out;
+    }
+    err = iwm_awdl_mcc_sta_cmd(sc, true);
+    if (err)
+        goto out;
+    sc->sc_awdl_mcc_state |= IWM_AWDL_MCC_STA_ACTIVE;
+    completed_stage |= IWM_AWDL_MCC_STA_ACTIVE;
+    if (sc->sc_awdl_te_enabled) {
+        err = iwm_awdl_mcc_time_event_cmd(sc, true, 0, 16, 16, true);
+        if (err)
+            goto out;
+    }
+    if (!isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_DYNAMIC_QUOTA))
+        err = iwm_update_quotas(sc, (struct iwm_node *)ic->ic_bss, 1);
+out:
+    splx(s);
+    if (failure_stage != NULL)
+        *failure_stage = completed_stage;
+    if (err) {
+        IOLog("itlwm: AWDL_MCC_V1 setup failed stage=0x%x channel=%u error=%d\n",
+              completed_stage, channel, err);
+        iwm_awdl_mcc_teardown();
+    } else {
+        IOLog("itlwm: AWDL_MCC_V1 active phy=%u mac=%u sta=%u queue=%u channel=%u address=%s\n",
+              IWM_AWDL_PHY_INDEX, IWM_AWDL_MAC_INDEX, IWM_AWDL_BSTA(sc),
+              IWM_AWDL_TXQ(sc), channel,
+              ether_sprintf(sc->sc_awdl_mcc_macaddr));
+    }
+    return err;
+}
+
+void ItlIwm::
+iwm_awdl_mcc_teardown(void)
+{
+    struct iwm_softc *sc = &com;
+    struct ieee80211com *ic = &sc->sc_ic;
+    int s = splnet();
+
+    if (awdl9560Requested && ic->ic_awdl_rx != nullptr) {
+        ic->ic_awdl_rx = nullptr;
+        ic->ic_awdl_rx_arg = nullptr;
+        if (auto *controller = getController())
+            controller->setProperty("ITL9560AWDLState", "waiting for association");
+    }
+    if (sc->sc_awdl_te_uid != 0)
+        iwm_awdl_mcc_time_event_cmd(sc, false, 0, 0, 0, false);
+    if (sc->sc_awdl_go) {
+        for (size_t i = 0; i < IWM_AWDL_PEER_MAX; ++i)
+            if (sc->sc_awdl_peer_active[i])
+                iwm_awdl_peer_sta_cmd(
+                    sc, static_cast<uint8_t>(IWM_AWDL_PEER_STA_BASE + i),
+                    sc->sc_awdl_peer_addr[i], false);
+    }
+    memset(sc->sc_awdl_peer_active, 0, sizeof(sc->sc_awdl_peer_active));
+    memset(sc->sc_awdl_peer_addr, 0, sizeof(sc->sc_awdl_peer_addr));
+    iwm_awdl_go_mcast_sta(sc, false);
+    if (sc->sc_awdl_mcc_state & IWM_AWDL_MCC_STA_ACTIVE) {
+        iwm_flush_tx_path(sc, 1U << IWM_AWDL_TXQ(sc));
+        iwm_awdl_mcc_sta_cmd(sc, false);
+        sc->sc_awdl_mcc_state &= ~IWM_AWDL_MCC_STA_ACTIVE;
+    }
+    if (sc->sc_awdl_mcc_state & IWM_AWDL_MCC_QUEUE_ACTIVE) {
+        if (iwm_nic_lock(sc)) {
+            iwm_disable_txq_for_sta(sc, IWM_AWDL_BSTA(sc),
+                                    IWM_AWDL_TXQ(sc),
+                                    IWM_MAX_TID_COUNT, 0);
+            iwm_nic_unlock(sc);
+        }
+        sc->sc_awdl_mcc_state &= ~IWM_AWDL_MCC_QUEUE_ACTIVE;
+    }
+    if (sc->sc_awdl_mcc_state & IWM_AWDL_MCC_BINDING_ACTIVE) {
+        if (sc->sc_awdl_mcc_shared) {
+            if (sc->sc_flags & IWM_FLAG_BINDING_ACTIVE)
+                iwm_awdl_mcc_shared_binding_cmd(sc, false);
+        } else {
+            iwm_awdl_mcc_binding_cmd(sc, IWM_FW_CTXT_ACTION_REMOVE);
+        }
+        sc->sc_awdl_mcc_state &= ~IWM_AWDL_MCC_BINDING_ACTIVE;
+    }
+    if (sc->sc_awdl_mcc_state & IWM_AWDL_MCC_MAC_ACTIVE) {
+        iwm_awdl_mcc_mac_cmd(sc, sc->sc_awdl_mcc_macaddr,
+                             IWM_FW_CTXT_ACTION_REMOVE);
+        sc->sc_awdl_mcc_state &= ~IWM_AWDL_MCC_MAC_ACTIVE;
+    }
+    sc->sc_awdl_mcc_state = 0;
+    sc->sc_awdl_mcc_shared = 0;
+    sc->sc_awdl_mcc_channel = 0;
+    memset(sc->sc_awdl_mcc_macaddr, 0, sizeof(sc->sc_awdl_mcc_macaddr));
+    const bool restoreSf = sc->sc_awdl_sf_forced;
+    sc->sc_awdl_sf_forced = false;
+    if (restoreSf && (sc->sc_flags & (IWM_FLAG_HW_ERR | IWM_FLAG_SHUTDOWN)) == 0) {
+        const bool associated = ic->ic_state == IEEE80211_S_RUN &&
+            (sc->sc_flags & IWM_FLAG_STA_ACTIVE) != 0;
+        iwm_sf_config(sc, associated ? IWM_SF_FULL_ON : IWM_SF_INIT_OFF);
+    }
+    if (ic->ic_state == IEEE80211_S_RUN &&
+        (sc->sc_flags & IWM_FLAG_BINDING_ACTIVE) != 0 &&
+        !isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_DYNAMIC_QUOTA))
+        iwm_update_quotas(sc, (struct iwm_node *)ic->ic_bss, 1);
+    splx(s);
+}
