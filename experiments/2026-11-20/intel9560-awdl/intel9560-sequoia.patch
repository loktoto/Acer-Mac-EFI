+int ItlIwm::
+iwm_awdl_mcc_mac_cmd(struct iwm_softc *sc, const uint8_t *address,
+                     uint32_t action)
+{
+    struct ieee80211com *ic = &sc->sc_ic;
+    struct iwm_mac_ctx_cmd cmd;
+    int i;
+
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.id_and_color = htole32(IWM_AWDL_MACID(sc));
+    cmd.action = htole32(action);
+    // Match iwlwifi's P2P-device model.  A BSS_STA MAC expects link stations
+    // and association state; adding such stations to our unassociated AWDL
+    // context caused firmware error 0x2073.  P2P_DEVICE instead uses the
+    // single internal broadcast/general-purpose station on queue 2 below.
+    cmd.mac_type = htole32(IWM_FW_MAC_TYPE_P2P_DEVICE);
+    // iwlwifi: a GO shares the associated station's TSF (station leads,
+    // GO follows) to keep TBTTs apart; itlwm_awdl_go_tsf selects it.
+    cmd.tsf_id = htole32(IWM_AWDL_BEACONING(sc) ? sc->sc_awdl_go_tsf :
+                         IWM_TSF_ID_B);
+    IEEE80211_ADDR_COPY(cmd.node_addr, address);
+    IEEE80211_ADDR_COPY(cmd.bssid_addr, etherbroadcastaddr);
+    // itlwm_awdl_ibss=1: P2P_DEVICE passes a peer's unicast management
+    // frames but not its data. AWDL behaves like an IBSS on BSSID
+    // 00:25:00:ff:94:73, and IBSS data from peers without a station entry
+    // is delivered to the host (mac80211 ibss_rx_no_sta). Fields follow
+    // iwlwifi's iwl_mvm_mac_ctxt_cmd_ibss(); no beacon template is ever
+    // sent, so the firmware has nothing to beacon.
+    // itlwm_awdl_go=1: a P2P GO MAC. STA+GO is a supported firmware
+    // combination and a GO holds per-client LINK stations (added from
+    // IO80211's PEER_CACHE_CONTROL). Fields follow iwlwifi's
+    // iwl_mvm_mac_ctxt_cmd_go(); no beacon template is sent.
+    if (sc->sc_awdl_go) {
+        static const uint8_t awdlBssid[ETHER_ADDR_LEN] =
+            { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+        cmd.mac_type = htole32(IWM_FW_MAC_TYPE_GO);
+        // An AP/GO BSSID is its own address (iwlwifi: vif->bss_conf.bssid).
+        // With the AWDL BSSID here, adding the broadcast station asserted
+        // 0x3438 (data1 = station 3). AWDL frames still carry 00:25:00:ff:94:73
+        // in addr3 themselves, and PROMISC delivers peer frames.
+        (void)awdlBssid;
+        IEEE80211_ADDR_COPY(cmd.bssid_addr, address);
+        cmd.go.ap.bi = htole32(100);
+        cmd.go.ap.bi_reciprocal = htole32(0xffffffffU / 100U);
+        cmd.go.ap.dtim_interval = htole32(100);
+        cmd.go.ap.dtim_reciprocal = htole32(0xffffffffU / 100U);
+        // iwlwifi fill_ap: mcast_qid is the CAB queue, and only for firmware
+        // without station-type API (otherwise the multicast station owns it).
+        if (!isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE))
+            cmd.go.ap.mcast_qid = htole32(IWM_DQA_GCAST_QUEUE);
+        // Beacon time: device time when added (the 2026-09-27 GO sent 0).
+        cmd.go.ap.beacon_time = htole32(sc->sc_awdl_go_beacon_time);
+        cmd.go.ap.beacon_tsf = 0;
+        cmd.go.ap.beacon_template = htole32(IWM_AWDL_MAC_INDEX);
+    }
+    // itlwm_awdl_bss_sta=1: the pre-2026-09-27 AWDL MAC role. Firmware ACKs
+    // a peer's unicast to node_addr in BSS_STA (P2P_DEVICE is a discovery
+    // role and never ACKs data, so the iPhone saw every frame as lost). On
+    // the separate PHY, PROMISC still delivers the frames to the host. No
+    // per-peer ADD_STA is ever issued (that asserted 0x2073 on this MAC).
+    if (sc->sc_awdl_bss_sta && !sc->sc_awdl_go && !sc->sc_awdl_ibss) {
+        static const uint8_t awdlBssid[ETHER_ADDR_LEN] =
+            { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+        cmd.mac_type = htole32(IWM_FW_MAC_TYPE_BSS_STA);
+        IEEE80211_ADDR_COPY(cmd.bssid_addr, awdlBssid);
+    }
+    if (sc->sc_awdl_ibss) {
+        static const uint8_t awdlBssid[ETHER_ADDR_LEN] =
+            { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+        cmd.mac_type = htole32(IWM_FW_MAC_TYPE_IBSS);
+        IEEE80211_ADDR_COPY(cmd.bssid_addr, awdlBssid);
+        cmd.ibss.bi = htole32(100);
+        cmd.ibss.bi_reciprocal = htole32(0xffffffffU / 100U);
+        cmd.ibss.beacon_template = htole32(IWM_AWDL_MAC_INDEX);
+    }
+    /* 6, 12 and 24 Mbps are the mandatory 5 GHz basic rates. */
+    cmd.ofdm_rates = htole32(0x15);
+    cmd.filter_flags = htole32(IWM_MAC_FILTER_IN_CONTROL_AND_MGMT |
+        IWM_MAC_FILTER_ACCEPT_GRP |
+        IWM_MAC_FILTER_IN_BEACON |
+        IWM_MAC_FILTER_IN_PROBE_REQUEST);
+    // Promiscuous RX inside the station's binding is the known UMAC-assert
+    // trigger (see iwm_mac_ctxt_cmd). In a shared binding the AWDL MAC gets
+    // frames for its own address and group frames without it.
+    // itlwm_awdl_promisc=1 re-tests it on the P2P_DEVICE MAC: that role
+    // passes the peer's unicast management frames but not its data frames.
+    // iwlwifi never sets PROMISC on an AP/GO/IBSS MAC; itlwm_awdl_go_nopromisc
+    // tests whether it is why the GO broadcast station asserts 0x3438.
+    if ((!sc->sc_awdl_mcc_shared || sc->sc_awdl_force_promisc) &&
+        !(IWM_AWDL_BEACONING(sc) && sc->sc_awdl_go_nopromisc))
+        cmd.filter_flags |= htole32(IWM_MAC_FILTER_IN_PROMISC);
+
+    for (i = 0; i < EDCA_NUM_AC; i++) {
+        struct ieee80211_edca_ac_params *ac = &ic->ic_edca_ac[i];
+        const uint8_t ucode_ac = iwm_mvm_mac80211_ac_to_ucode_ac(
+            (enum ieee80211_edca_ac)i);
+        cmd.ac[ucode_ac].cw_min = htole16((1U << ac->ac_ecwmin) - 1U);
+        cmd.ac[ucode_ac].cw_max = htole16((1U << ac->ac_ecwmax) - 1U);
+        cmd.ac[ucode_ac].aifsn = ac->ac_aifsn;
+        cmd.ac[ucode_ac].fifos_mask = (1U << iwm_ac_to_tx_fifo[i]);
+        cmd.ac[ucode_ac].edca_txop = htole16(ac->ac_txoplimit * 32);
+    }
+    // AP/GO: the MCAST FIFO takes its EDCA parameters from VO (iwlwifi).
+    if (sc->sc_awdl_go)
+        cmd.ac[iwm_mvm_mac80211_ac_to_ucode_ac(EDCA_AC_VO)].fifos_mask |=
+            (1U << IWM_TX_FIFO_MCAST);
+    cmd.qos_flags = htole32(IWM_MAC_QOS_FLG_UPDATE_EDCA);
+
+    iwm_note_mac_ctxt_cmd(sc, IWM_AWDL_MAC_INDEX, action);
+    const int err = iwm_send_cmd_pdu(sc, IWM_MAC_CONTEXT_CMD, 0,
+                                     sizeof(cmd), &cmd);
+    if (err == 0) {
+        if (action == IWM_FW_CTXT_ACTION_ADD) {
+            ic->ic_awdl_rx_filter_programmed = true;
+            IOLog("itlwm: AWDL_MCC_RX_FILTER_V1 enabled flags=0x%x\n",
+                  letoh32(cmd.filter_flags));
+        } else if (action == IWM_FW_CTXT_ACTION_REMOVE) {
+            ic->ic_awdl_rx_filter_programmed = false;
+        }
+    }
+    return err;
+}
+
+int ItlIwm::
+iwm_awdl_mcc_binding_cmd(struct iwm_softc *sc, uint32_t action)
+{
+    struct iwm_binding_cmd cmd;
+    struct iwm_phy_ctxt *phyctxt = &sc->sc_phyctxt[IWM_AWDL_PHY_INDEX];
+    uint32_t status = 0;
+    size_t len;
+    int i, err;
+
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.id_and_color = htole32(IWM_FW_CMD_ID_AND_COLOR(phyctxt->id,
+                                                        phyctxt->color));
+    cmd.action = htole32(action);
+    cmd.phy = htole32(IWM_FW_CMD_ID_AND_COLOR(phyctxt->id, phyctxt->color));
+    cmd.macs[0] = htole32(IWM_AWDL_MACID(sc));
+    for (i = 1; i < IWM_MAX_MACS_IN_BINDING; i++)
+        cmd.macs[i] = htole32(IWM_FW_CTXT_INVALID);
+    cmd.lmac_id = htole32(IWM_LMAC_5G_INDEX);
+
+    len = isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_BINDING_CDB_SUPPORT) ?
+        sizeof(cmd) : sizeof(struct iwm_binding_cmd_v1);
+    err = iwm_send_cmd_pdu_status(sc, IWM_BINDING_CONTEXT_CMD, len, &cmd,
+                                  &status);
+    if (err == 0 && status != 0)
+        err = EIO;
+    return err;
+}
+
+// With the AWDL MAC on the station's own channel, a second PHY context makes
+// the firmware time-share two bindings on one primary channel: about a third
+// of the AWDL events were skipped for station beacons. Like iwlwifi with a P2P
+// vif on the BSS channel, put both MACs in the station's binding instead.
+int ItlIwm::
+iwm_awdl_mcc_shared_binding_cmd(struct iwm_softc *sc, bool withAwdl)
+{
+    struct ieee80211com *ic = &sc->sc_ic;
+    struct iwm_node *in = (struct iwm_node *)ic->ic_bss;
+    struct iwm_phy_ctxt *phyctxt = in != NULL ? in->in_phyctxt : NULL;
+    struct iwm_binding_cmd cmd;
+    uint32_t status = 0;
+    size_t len;
+    int i, err;
+
+    if (phyctxt == NULL || phyctxt->channel == NULL ||
+        (sc->sc_flags & IWM_FLAG_BINDING_ACTIVE) == 0)
+        return EINVAL;
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.id_and_color = htole32(IWM_FW_CMD_ID_AND_COLOR(phyctxt->id,
+                                                        phyctxt->color));
+    cmd.action = htole32(IWM_FW_CTXT_ACTION_MODIFY);
+    cmd.phy = htole32(IWM_FW_CMD_ID_AND_COLOR(phyctxt->id, phyctxt->color));
+    cmd.macs[0] = htole32(IWM_FW_CMD_ID_AND_COLOR(in->in_id, in->in_color));
+    for (i = 1; i < IWM_MAX_MACS_IN_BINDING; i++)
+        cmd.macs[i] = htole32(IWM_FW_CTXT_INVALID);
+    if (withAwdl)
+        cmd.macs[1] = htole32(IWM_AWDL_MACID(sc));
+    if (IEEE80211_IS_CHAN_2GHZ(phyctxt->channel) ||
+        !isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_CDB_SUPPORT))
+        cmd.lmac_id = htole32(IWM_LMAC_24G_INDEX);
+    else
+        cmd.lmac_id = htole32(IWM_LMAC_5G_INDEX);
+    len = isset(sc->sc_enabled_capa, IWM_UCODE_TLV_CAPA_BINDING_CDB_SUPPORT) ?
+        sizeof(cmd) : sizeof(struct iwm_binding_cmd_v1);
+    err = iwm_send_cmd_pdu_status(sc, IWM_BINDING_CONTEXT_CMD, len, &cmd,
+                                  &status);
+    if (err == 0 && status != 0)
+        err = EIO;
+    if (err == 0 && withAwdl)
+        ++sc->sc_awdl_shared_binds;
+    IOLog("itlwm: AWDL_SHARED_PHY_V1 binding phy=%u macs=%u%s err=%d\n",
+          phyctxt->id, in->in_id, withAwdl ? "+awdl" : "", err);
+    return err;
+}
+
+// BEACON_TEMPLATE_CMD for the AWDL GO MAC (iwlwifi send_beacon_v6/v7). Pre-
+// 22000 firmware (this 9560) needs the template before the MAC is added.
+// Minimal beacon: hidden SSID, 5 GHz OFDM rates, TIM; broadcast station 3.
+int ItlIwm::
+iwm_awdl_go_beacon_cmd(struct iwm_softc *sc, const uint8_t *address)
+{
+    static const uint8_t awdlBssid[ETHER_ADDR_LEN] =
+        { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+    static const uint8_t ies[] = {
+        0x00, 0x00,                                     /* SSID (hidden) */
+        0x01, 0x08, 0x8c, 0x12, 0x98, 0x24, 0xb0, 0x48, 0x60, 0x6c,
+        0x05, 0x04, 0x00, 0x01, 0x00, 0x00,             /* TIM */
+    };
+    const size_t timIdx = 24 + 12 + 2 + 10;
+    const uint16_t bi = 100;
+    const bool v9 = isset(sc->sc_ucode_api, 34);    /* NEW_BEACON_TEMPLATE */
+    const bool v7 = isset(sc->sc_enabled_capa, 70); /* CSA_AND_TBTT_OFFLOAD */
+    uint8_t frame[24 + 12 + sizeof(ies)];
+    memset(frame, 0, sizeof(frame));
+    frame[0] = IEEE80211_FC0_TYPE_MGT | IEEE80211_FC0_SUBTYPE_BEACON;
+    memset(frame + 4, 0xff, ETHER_ADDR_LEN);
+    IEEE80211_ADDR_COPY(frame + 10, address);
+    // GO: BSSID = own address. IBSS: the AWDL BSSID is the IBSS BSSID.
+    IEEE80211_ADDR_COPY(frame + 16, sc->sc_awdl_ibss ? awdlBssid : address);
+    frame[32] = bi & 0xff;
+    frame[33] = bi >> 8;
+    frame[34] = sc->sc_awdl_ibss ? 0x02 : 0x01;   /* IBSS : ESS */
+    memcpy(frame + 36, ies, sizeof(ies));
+    // IBSS beacons carry no TIM (iwlwifi sets tim_idx only for AP).
+    const size_t frameLen = sc->sc_awdl_ibss ? sizeof(frame) - 6 : sizeof(frame);
+    const uint32_t timIdxOut = sc->sc_awdl_ibss ? 0 : (uint32_t)timIdx;
+    const uint32_t timSizeOut = sc->sc_awdl_ibss ? 0 : 4;
+
+    if (v9) {
+        // BEACON_TEMPLATE_CMD_API_S_VER_9 (iwlwifi send_beacon_v9): byte_cnt,
+        // flags (rate PLCP; TX_CMD <= v8 and v1 flags), 8 reserved bytes,
+        // template id, tim_idx, tim_size, ecsa/csa offsets, then the frame.
+        struct {
+            uint16_t byte_cnt;
+            uint16_t flags;
+            uint8_t reserved[8];
+            uint32_t template_id;
+            uint32_t tim_idx;
+            uint32_t tim_size;
+            uint32_t ecsa_offset;
+            uint32_t csa_offset;
+        } __packed hdr9;
+        uint8_t buf9[sizeof(hdr9) + sizeof(frame)];
+        memset(&hdr9, 0, sizeof(hdr9));
+        hdr9.byte_cnt = htole16(frameLen);
+        hdr9.flags = htole16(13U);        /* 6 Mbps OFDM PLCP */
+        hdr9.template_id = htole32(IWM_AWDL_MAC_INDEX);
+        hdr9.tim_idx = htole32(timIdxOut);
+        hdr9.tim_size = htole32(timSizeOut);
+        memcpy(buf9, &hdr9, sizeof(hdr9));
+        memcpy(buf9 + sizeof(hdr9), frame, frameLen);
+        const int err9 = iwm_send_cmd_pdu(sc, IWM_BEACON_TEMPLATE_CMD, IWM_CMD_ASYNC,
+                                          sizeof(hdr9) + frameLen, buf9);
+        sc->sc_awdl_go_beacon_err = err9;
+        IOLog("itlwm: AWDL_GO_BEACON_V1 v9 len=%u err=%d\n",
+              (unsigned)sizeof(buf9), err9);
+        return err9;
+    }
+    uint8_t buf[sizeof(struct iwm_mac_beacon_cmd) + 8 + sizeof(frame)];
+    memset(buf, 0, sizeof(buf));
+    struct iwm_mac_beacon_cmd *bcmd = (struct iwm_mac_beacon_cmd *)buf;
+    uint8_t ant = iwm_fw_valid_tx_ant(sc);
+    ant &= (uint8_t)-ant;       /* lowest valid antenna */
+    bcmd->tx.len = htole16(sizeof(frame));
+    bcmd->tx.tx_flags = htole32(IWM_TX_CMD_FLG_SEQ_CTL | IWM_TX_CMD_FLG_TSF);
+    bcmd->tx.rate_n_flags = htole32(13U /* 6 Mbps OFDM PLCP */ |
+                                    ((uint32_t)ant << IWM_RATE_MCS_ANT_POS));
+    bcmd->tx.sta_id = IWM_AWDL_BSTA(sc);
+    bcmd->tx.life_time = htole32(IWM_TX_CMD_LIFE_TIME_INFINITE);
+    bcmd->template_id = htole32(IWM_AWDL_MAC_INDEX);
+    bcmd->tim_idx = htole32(timIdx);
+    bcmd->tim_size = htole32(4);
+    size_t off = sizeof(struct iwm_mac_beacon_cmd);
+    if (v7)
+        off += 8;               /* ecsa_offset, csa_offset = 0 */
+    memcpy(buf + off, frame, sizeof(frame));
+    const int err = iwm_send_cmd_pdu(sc, IWM_BEACON_TEMPLATE_CMD, IWM_CMD_ASYNC,
+                                     off + sizeof(frame), buf);
+    sc->sc_awdl_go_beacon_err = err;
+    IOLog("itlwm: AWDL_GO_BEACON_V1 v%d len=%u err=%d\n", v7 ? 7 : 6,
+          (unsigned)(off + sizeof(frame)), err);
+    return err;
+}
