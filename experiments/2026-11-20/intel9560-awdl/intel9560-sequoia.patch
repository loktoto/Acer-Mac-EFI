+int ItlIwm::
+iwm_awdl_peer_cache_update(const uint8_t *address, bool add)
+{
+    struct iwm_softc *sc = &com;
+    if (address == NULL || IEEE80211_ADDR_EQ(address, etheranyaddr) ||
+        IEEE80211_IS_MULTICAST(address))
+        return EINVAL;
+    if (sc->sc_awdl_mcc_state != IWM_AWDL_MCC_ACTIVE)
+        return EAGAIN;
+
+    int s = splnet();
+    int matching = -1;
+    int freeSlot = -1;
+    for (size_t i = 0; i < IWM_AWDL_PEER_MAX; ++i) {
+        if (sc->sc_awdl_peer_active[i] &&
+            IEEE80211_ADDR_EQ(sc->sc_awdl_peer_addr[i], address))
+            matching = static_cast<int>(i);
+        else if (!sc->sc_awdl_peer_active[i] && freeSlot < 0)
+            freeSlot = static_cast<int>(i);
+    }
+
+    if (add && matching >= 0) {
+        sc->sc_awdl_peer_last_error = 0;
+        splx(s);
+        return 0;
+    }
+    if (!add && matching < 0) {
+        sc->sc_awdl_peer_last_error = 0;
+        splx(s);
+        return 0;
+    }
+
+    const int slot = add ? freeSlot : matching;
+    // On a GO MAC (itlwm_awdl_go=1) each peer is a real client station:
+    // that is what lets firmware deliver its unicast data to the host.
+    int err = slot < 0 ? ENOSPC : 0;
+    if (err == 0 && sc->sc_awdl_go)
+        err = iwm_awdl_peer_sta_cmd(
+            sc, static_cast<uint8_t>(IWM_AWDL_PEER_STA_BASE + slot),
+            address, add);
+    sc->sc_awdl_peer_last_error = err;
+    if (err == 0) {
+        if (add) {
+            IEEE80211_ADDR_COPY(sc->sc_awdl_peer_addr[slot], address);
+            sc->sc_awdl_peer_active[slot] = 1;
+            ++sc->sc_awdl_peer_adds;
+        } else {
+            sc->sc_awdl_peer_active[slot] = 0;
+            memset(sc->sc_awdl_peer_addr[slot], 0, ETHER_ADDR_LEN);
+            ++sc->sc_awdl_peer_deletes;
+        }
+        // IO80211 requires Broadcom-style completion indications to retire
+        // its cache-pending state.  On P2P_DEVICE the cache is host-side
+        // metadata only (LINK stations there cause firmware error 0x2073);
+        // on the GO MAC each peer is also a firmware client station.
+        IOLog("itlwm: AWDL_PEER_CACHE_V2 %s slot=%d peer=%s %s\n",
+              add ? "add" : "delete", slot, ether_sprintf(address),
+              sc->sc_awdl_go ? "go-client" : "host-only");
+    } else {
+        ++sc->sc_awdl_peer_failures;
+        IOLog("itlwm: AWDL_PEER_CACHE_V1 %s failed peer=%s error=%d\n",
+              add ? "add" : "delete", ether_sprintf(address), err);
+    }
+    splx(s);
+    return err;
+}
+
+void ItlIwm::
+iwm_awdl_peer_cache_stats(uint32_t *out5, uint8_t *addresses) const
+{
+    uint32_t active = 0;
+    for (size_t i = 0; i < IWM_AWDL_PEER_MAX; ++i) {
+        if (com.sc_awdl_peer_active[i])
+            ++active;
+        memcpy(addresses + i * ETHER_ADDR_LEN,
+               com.sc_awdl_peer_addr[i], ETHER_ADDR_LEN);
+    }
+    out5[0] = active;
+    out5[1] = com.sc_awdl_peer_adds;
+    out5[2] = com.sc_awdl_peer_deletes;
+    out5[3] = com.sc_awdl_peer_failures;
+    out5[4] = static_cast<uint32_t>(com.sc_awdl_peer_last_error);
+}
