+void ItlIwm::
+iwm_note_sw_error(struct iwm_softc *sc)
+{
+    const uint32_t base = sc->sc_uc.uc_error_event_table;
+    const uint32_t umacBase = sc->sc_uc.uc_umac_error_event_table;
+
+    ++sc->sc_diag_sw_errors;
+    memcpy(sc->sc_diag_mac_cmd_at_error, sc->sc_diag_mac_cmd_ring,
+           sizeof(sc->sc_diag_mac_cmd_at_error));
+    // Error table: valid, error_id, ... (as read by iwm_nic_error()).
+    if (base >= 0x800000 &&
+        iwm_read_mem(sc, base, sc->sc_diag_lmac_table,
+                     nitems(sc->sc_diag_lmac_table)) == 0 &&
+        sc->sc_diag_lmac_table[0])
+        sc->sc_diag_last_error_id = sc->sc_diag_lmac_table[1];
+    // UMAC: valid, error_id, blink1/2, ilink1/2, data1-3, major, minor,
+    // frame/stack pointer, cmd_header (last host command), nic_isr_pref.
+    if (umacBase >= 0x800000)
+        iwm_read_mem(sc, umacBase, sc->sc_diag_umac_table,
+                     nitems(sc->sc_diag_umac_table));
+}
+
+// Ring of the last eight MAC_CONTEXT_CMDs: (seq << 16) | (mac_id << 8) | action.
+// The UMAC error table names only the command ID, not whose context it was.
+void ItlIwm::
+iwm_note_mac_ctxt_cmd(struct iwm_softc *sc, uint32_t macId, uint32_t action)
+{
+    const uint32_t seq = ++sc->sc_diag_mac_cmd_seq;
+    sc->sc_diag_mac_cmd_ring[(seq - 1) % nitems(sc->sc_diag_mac_cmd_ring)] =
+        (seq << 16) | ((macId & 0xff) << 8) | (action & 0xff);
+}
