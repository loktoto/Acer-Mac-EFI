+// A client station of the AWDL GO MAC for one IO80211 peer: exact MAC, no
+// TX queue (queue 2 stays with broadcast station 3), all TIDs TX-disabled.
+int ItlIwm::
+iwm_awdl_peer_sta_cmd(struct iwm_softc *sc, uint8_t staId,
+                      const uint8_t *address, bool add)
+{
+    if (!add) {
+        struct iwm_rm_sta_cmd rm;
+        memset(&rm, 0, sizeof(rm));
+        rm.sta_id = staId;
+        return iwm_send_cmd_pdu(sc, IWM_REMOVE_STA, 0, sizeof(rm), &rm);
+    }
+    struct iwm_add_sta_cmd cmd;
+    uint32_t status = IWM_ADD_STA_SUCCESS;
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.sta_id = staId;
+    cmd.mac_id_n_color = htole32(IWM_AWDL_MACID(sc));
+    IEEE80211_ADDR_COPY(cmd.addr, address);
+    cmd.tid_disable_tx = htole16(0xffff);
+    if (isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE))
+        cmd.station_type = IWM_STA_LINK;
+    const size_t cmdsize = isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE) ?
+        sizeof(cmd) : sizeof(struct iwm_add_sta_cmd_v7);
+    int err = iwm_send_cmd_pdu_status(sc, IWM_ADD_STA, cmdsize, &cmd, &status);
+    if (!err && (status & IWM_ADD_STA_STATUS_MASK) != IWM_ADD_STA_SUCCESS)
+        err = EIO;
+    return err;
+}
