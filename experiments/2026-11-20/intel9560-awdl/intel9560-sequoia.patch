+// GO multicast station on the CAB queue (iwlwifi iwl_mvm_add_mcast_sta).
+int ItlIwm::
+iwm_awdl_go_mcast_sta(struct iwm_softc *sc, bool add)
+{
+    if (!add) {
+        if (!sc->sc_awdl_go_mcast_active)
+            return 0;
+        struct iwm_rm_sta_cmd rm;
+        memset(&rm, 0, sizeof(rm));
+        rm.sta_id = IWM_AWDL_MCAST_STA_ID;
+        iwm_flush_tx_path(sc, 1U << IWM_DQA_GCAST_QUEUE);
+        if (iwm_nic_lock(sc)) {
+            iwm_disable_txq_for_sta(sc, IWM_AWDL_MCAST_STA_ID,
+                                    IWM_DQA_GCAST_QUEUE, 0, 0);
+            iwm_nic_unlock(sc);
+        }
+        sc->sc_awdl_go_mcast_active = 0;
+        return iwm_send_cmd_pdu(sc, IWM_REMOVE_STA, 0, sizeof(rm), &rm);
+    }
+    static const uint8_t maddr[ETHER_ADDR_LEN] = { 0x03, 0, 0, 0, 0, 0 };
+    struct iwm_add_sta_cmd cmd;
+    uint32_t status = IWM_ADD_STA_SUCCESS;
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.sta_id = IWM_AWDL_MCAST_STA_ID;
+    cmd.mac_id_n_color = htole32(
+        IWM_AWDL_MACID(sc));
+    IEEE80211_ADDR_COPY(cmd.addr, maddr);
+    cmd.tfd_queue_msk = htole32(1U << IWM_DQA_GCAST_QUEUE);
+    cmd.tid_disable_tx = htole16(0xffff);
+    const bool staType = isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE);
+    if (staType)
+        cmd.station_type = IWM_STA_MULTICAST;
+    int err = 0;
+    // iwlwifi iwl_mvm_add_mcast_sta(): on non-TVQM firmware WITH station-type
+    // API the CAB queue is enabled BEFORE ADD_STA (and is in the TFD mask);
+    // only without that API is it enabled after. The reverse order asserted
+    // 0x21A0 (data1 = station 8) on this firmware.
+    if (staType) {
+        if (!iwm_nic_lock(sc))
+            return EBUSY;
+        err = iwm_enable_txq(sc, IWM_AWDL_MCAST_STA_ID, IWM_DQA_GCAST_QUEUE,
+                             sc->sc_awdl_ibss ? IWM_TX_FIFO_BE : IWM_TX_FIFO_MCAST,
+                             0, 0, 0);
+        iwm_nic_unlock(sc);
+        if (err)
+            return err;
+    }
+    err = iwm_send_cmd_pdu_status(sc, IWM_ADD_STA,
+        staType ? sizeof(cmd) : sizeof(struct iwm_add_sta_cmd_v7),
+        &cmd, &status);
+    if (!err && (status & IWM_ADD_STA_STATUS_MASK) != IWM_ADD_STA_SUCCESS)
+        err = EIO;
+    if (err)
+        return err;
+    if (!staType) {
+        if (!iwm_nic_lock(sc))
+            return EBUSY;
+        err = iwm_enable_txq(sc, IWM_AWDL_MCAST_STA_ID, IWM_DQA_GCAST_QUEUE,
+                             IWM_TX_FIFO_MCAST, 0, 0, 0);
+        iwm_nic_unlock(sc);
+        if (err)
+            return err;
+    }
+    sc->sc_awdl_go_mcast_active = 1;
+    return 0;
+}
+
+int ItlIwm::
+iwm_awdl_mcc_sta_cmd(struct iwm_softc *sc, bool add)
+{
+    if (!add) {
+        struct iwm_rm_sta_cmd rm;
+        memset(&rm, 0, sizeof(rm));
+        rm.sta_id = IWM_AWDL_BSTA(sc);
+        return iwm_send_cmd_pdu(sc, IWM_REMOVE_STA, 0, sizeof(rm), &rm);
+    }
+
+    struct iwm_add_sta_cmd cmd;
+    uint32_t status = IWM_ADD_STA_SUCCESS;
+    size_t cmdsize;
+    int err;
+
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.sta_id = IWM_AWDL_BSTA(sc);
+    cmd.mac_id_n_color = htole32(
+        IWM_AWDL_MACID(sc));
+    IEEE80211_ADDR_COPY(cmd.addr, etherbroadcastaddr);
+    cmd.tfd_queue_msk = htole32(1U << IWM_AWDL_TXQ(sc));
+    cmd.tid_disable_tx = htole16(0xffff);
+    if (isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE))
+        cmd.station_type = IWM_STA_GENERAL_PURPOSE;
+    cmdsize = isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE) ?
+        sizeof(cmd) : sizeof(struct iwm_add_sta_cmd_v7);
+    err = iwm_send_cmd_pdu_status(sc, IWM_ADD_STA, cmdsize, &cmd, &status);
+    if (!err && (status & IWM_ADD_STA_STATUS_MASK) != IWM_ADD_STA_SUCCESS)
+        err = EIO;
+    return err;
+}
