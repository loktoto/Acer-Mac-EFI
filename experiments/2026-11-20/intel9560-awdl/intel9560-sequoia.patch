+extern bool itlAWDLBuildVerified();
+
+void ItlIwm::start9560AwDLListener()
+{
+    if (!awdl9560Requested)
+        return;
+    auto *controller = getController();
+    if (!controller)
+        return;
+    if (!itlAWDLBuildVerified()) {
+        controller->setProperty("ITL9560AWDLState", "macOS build not verified");
+        return;
+    }
+
+    auto *sc = &com;
+    auto *ic = &sc->sc_ic;
+    auto *bss = reinterpret_cast<struct iwm_node *>(ic->ic_bss);
+    if (!bss || !bss->in_phyctxt || !bss->in_phyctxt->channel) {
+        controller->setProperty("ITL9560AWDLState", "waiting for an associated channel");
+        return;
+    }
+    const uint16_t channel = ieee80211_chan2ieee(ic, bss->in_phyctxt->channel);
+    controller->setProperty("ITL9560AWDLChannel", channel, 32);
+    if (channel != 44 && channel != 149) {
+        controller->setProperty("ITL9560AWDLState", "waiting for the Wi-Fi connection on channel 44 or 149");
+        return;
+    }
+    const uint32_t flags = iwm_awdl_reg_flags(channel);
+    const uint32_t required = IWM_NVM_CHANNEL_VALID | IWM_NVM_CHANNEL_ACTIVE;
+    if ((flags & (required | IWM_NVM_CHANNEL_RADAR)) != required) {
+        controller->setProperty("ITL9560AWDLState", "firmware does not permit the channel");
+        return;
+    }
+
+    // Keep the infrastructure station on its present PHY. The extra listener MAC
+    // gets a distinct locally administered address and this probe queues no frames.
+    uint8_t address[IEEE80211_ADDR_LEN];
+    IEEE80211_ADDR_COPY(address, ic->ic_myaddr);
+    address[0] |= 0x02;
+    address[IEEE80211_ADDR_LEN - 1] ^= 0x01;
+    iwm_set_awdl_shared_phy(true);
+    uint32_t stage = 0;
+    const int error = iwm_awdl_mcc_configure(address, channel, &stage);
+    if (!error && !iwm_awdl_mcc_shared()) {
+        iwm_awdl_mcc_teardown();
+        controller->setProperty("ITL9560AWDLState", "shared PHY unavailable");
+        return;
+    }
+    controller->setProperty("ITL9560AWDLSetupStage", stage, 32);
+    controller->setProperty("ITL9560AWDLSetupError", static_cast<uint32_t>(error), 32);
+    controller->setProperty("ITL9560AWDLState", error ? "listener configuration failed" : "listening");
+    if (!error) {
+        ic->ic_awdl_rx_arg = this;
+        ic->ic_awdl_rx = count9560AwDLAction;
+        controller->setProperty("ITL9560AWDLActionFrames", awdl9560ActionFrames, 32);
+    }
+}
+
+void ItlIwm::count9560AwDLAction(void *context, const uint8_t *frame, size_t length,
+                                uint8_t channel, int8_t, uint32_t)
+{
+    auto *driver = static_cast<ItlIwm *>(context);
+    if (!driver->iwm_awdl_mcc_active() || channel != driver->com.sc_awdl_mcc_channel)
+        return;
+    ItlAWDL::ActionFrame action;
+    if (ItlAWDL::parseAction(frame, ItlAWDL::trimZeroPadding(frame, length), &action) != ItlAWDL::ParseResult::Valid)
+        return;
+    const uint32_t count = ++driver->awdl9560ActionFrames;
+    // Publish sparingly on the receive path. Keep no payload or peer identity.
+    if (count && (count & (count - 1)) == 0) {
+        if (auto *controller = driver->getController())
+            controller->setProperty("ITL9560AWDLActionFrames", count, 32);
+    }
+}
